{
  "name": "antigravity-dashboard",
  "version": "0.2.0",
  "description": "Real-time monitoring dashboard for Google Cloud accounts using the Antigravity OAuth flow. Track API quotas, usage limits, and reset times with Claude/OpenAI compatible API proxy.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoeFabris/antigravity-dashboard.git"
  },
  "homepage": "https://github.com/NoeFabris/antigravity-dashboard#readme",
  "bugs": {
    "url": "https://github.com/NoeFabris/antigravity-dashboard/issues"
  },
  "keywords": [
    "antigravity",
    "opencode",
    "google-cloud",
    "quota-monitoring",
    "claude",
    "gemini",
    "api-proxy",
    "oauth",
    "dashboard"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "agn-dash": "./bin/agn-dash.js",
    "antigravity-dashboard": "./bin/agn-dash.js"
  },
  "files": [
    "bin",
    "scripts",
    "apps/backend/dist",
    "apps/backend/package.json",
    "apps/web/dist",
    "apps/web/package.json",
    ".env.example"
  ],
  "scripts": {
    "build": "pnpm --filter=./apps/* run build",
    "predev": "pnpm --filter=@antigravity/backend build",
    "dev": "concurrently -k -n \"tsc,backend,frontend\" -c \"cyan.bold,blue.bold,magenta.bold\" \"pnpm --filter=@antigravity/backend run watch\" \"node --watch-path=apps/backend/dist apps/backend/dist/server.js\" \"pnpm --filter=@antigravity/web dev\"",
    "dev:all": "pnpm run dev",
    "prestart": "node scripts/ensure-build.js",
    "start": "pnpm --filter=@antigravity/backend start",
    "start:all": "pnpm start",
    "global:link": "npm link",
    "global:unlink": "npm unlink -g antigravity-dashboard",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "^1.39.0"
  }
}
